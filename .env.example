# ============================================================
# Единый пример переменных окружения для всех сервисов.
# Скопируйте в .env и заполните реальными значениями.
# Никогда не коммитьте .env с секретами.
# ============================================================

# --- Общая инфраструктура ---
POSTGRES_USER=k-technology
POSTGRES_PASSWORD=change_me
POSTGRES_DB=k-technology
# DSN, который читают сервисы (host=postgres внутри docker-сети)
DATABASE_URL=postgresql://k-technology:change_me@postgres:5432/k-technology

QDRANT_URL=http://qdrant:6333

# --- Режим работы сервисов: real | mock ---
# При mock сервисы ходят в mock-* контейнеры вместо реальных API.
APP_MODE=mock

# --- LLM Gateway (E1) ---
LLM_PROVIDER_DEFAULT=openai            # openai | anthropic
LLM_MODEL_CHEAP=gpt-4o-mini            # базовый тир
LLM_MODEL_STRONG=gpt-4o                # усиленный тир
LLM_MODEL_ANTHROPIC=claude-3-5-haiku-latest   # модель для фолбэка на Anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small
# Базовые URL провайдеров (переопределяются для тестов/прокси)
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- RAG (E2) ---
RAG_TOP_K=5
RAG_COLLECTION=k-technology_kb

# --- Channels (E3) ---
TELEGRAM_BOT_TOKEN=
# Базовый URL Telegram (переопределяемый для тестов)
TELEGRAM_BASE_URL=https://api.telegram.org
# Секретный токен вебхука Telegram (X-Telegram-Bot-Api-Secret-Token); пусто = проверка выключена
TELEGRAM_WEBHOOK_SECRET=
# WhatsApp режим: cloud_api | web_bridge
WA_MODE=web_bridge
# cloud_api (верифицированный)
WA_CLOUD_BASE_URL=https://graph.facebook.com/v20.0
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_ID=
WA_CLOUD_VERIFY_TOKEN=
# App Secret для HMAC-проверки X-Hub-Signature-256; пусто = проверка выключена (dev)
WA_APP_SECRET=
# web_bridge (неверифицированный, напр. WAHA/Evolution API)
WA_BRIDGE_URL=http://wa-bridge:3000
WA_BRIDGE_API_KEY=
WA_BRIDGE_SESSION=default

# --- CRM (E5): amocrm | bitrix24 ---
CRM_PROVIDER=amocrm
# amoCRM
AMOCRM_BASE_URL=
AMOCRM_ACCESS_TOKEN=
AMOCRM_REFRESH_TOKEN=
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_REDIRECT_URI=https://example.com   # для refresh_token grant
AMOCRM_PIPELINE_ID=                        # id воронки для смены этапа
AMOCRM_STAGE_MAP=                          # JSON {"new":"142","won":"143"}; пусто = дефолт
AMOCRM_NOTE_ENTITY=leads                   # сущность для заметок
# Bitrix24 (входящий вебхук REST)
BITRIX24_WEBHOOK_URL=
BITRIX24_STAGE_MAP=                        # JSON {"won":"WON"}; пусто = pass-through
BITRIX24_NOTE_ENTITY=lead                  # сущность для timeline-комментария

# --- Внутренние URL сервисов (docker-сеть) ---
LLM_GATEWAY_URL=http://llm-gateway:8000
RAG_URL=http://rag:8000
CHANNEL_GATEWAY_URL=http://channel-gateway:8000
CRM_CONNECTOR_URL=http://crm-connector:8000
N8N_WEBHOOK_BASE=http://n8n:5678

# --- n8n ---
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me

# --- Metabase ---
MB_DB_FILE=/metabase-data/metabase.db
