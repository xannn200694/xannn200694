# ============================================================
# Единый пример переменных окружения для всех сервисов.
# Скопируйте в .env и заполните реальными значениями.
# Никогда не коммитьте .env с секретами.
# ============================================================

# --- Общая инфраструктура ---
POSTGRES_USER=kivano
POSTGRES_PASSWORD=change_me
POSTGRES_DB=kivano
# DSN, который читают сервисы (host=postgres внутри docker-сети)
DATABASE_URL=postgresql://kivano:change_me@postgres:5432/kivano

QDRANT_URL=http://qdrant:6333

# --- Режим работы сервисов: real | mock ---
# При mock сервисы ходят в mock-* контейнеры вместо реальных API.
APP_MODE=mock

# --- LLM Gateway (E1) ---
LLM_PROVIDER_DEFAULT=openai            # openai | anthropic
LLM_MODEL_CHEAP=gpt-4o-mini            # базовый тир
LLM_MODEL_STRONG=gpt-4o                # усиленный тир
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small

# --- RAG (E2) ---
RAG_TOP_K=5
RAG_COLLECTION=kivano_kb

# --- Channels (E3) ---
TELEGRAM_BOT_TOKEN=
# WhatsApp режим: cloud_api | web_bridge
WA_MODE=web_bridge
# cloud_api (верифицированный)
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_ID=
WA_CLOUD_VERIFY_TOKEN=
# web_bridge (неверифицированный, напр. WAHA/Evolution API)
WA_BRIDGE_URL=http://wa-bridge:3000
WA_BRIDGE_API_KEY=

# --- CRM (E5): amocrm | bitrix24 ---
CRM_PROVIDER=amocrm
# amoCRM
AMOCRM_BASE_URL=
AMOCRM_ACCESS_TOKEN=
AMOCRM_REFRESH_TOKEN=
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
# Bitrix24 (входящий вебхук REST)
BITRIX24_WEBHOOK_URL=

# --- Внутренние URL сервисов (docker-сеть) ---
LLM_GATEWAY_URL=http://llm-gateway:8000
RAG_URL=http://rag:8000
CHANNEL_GATEWAY_URL=http://channel-gateway:8000
CRM_CONNECTOR_URL=http://crm-connector:8000
N8N_WEBHOOK_BASE=http://n8n:5678

# --- n8n ---
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me

# --- Metabase ---
MB_DB_FILE=/metabase-data/metabase.db
